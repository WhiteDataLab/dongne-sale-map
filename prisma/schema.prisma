// 동네 세일 지도 — Prisma 스키마
// 스펙: docs/PROJECT_SPEC.md "4. 데이터 모델" 을 단일 진실 공급원으로 삼는다.
// 스키마와 스펙이 어긋나면 스펙을 먼저 갱신한 뒤 여기를 수정한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 서버리스(Vercel) 환경: 풀링된 URL 사용
  url       = env("DATABASE_URL")
  // 마이그레이션/스키마 푸시는 직접 연결 URL 사용 (Supabase/Neon 권장)
  directUrl = env("DIRECT_URL")
}

// ──────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────

enum Provider {
  kakao
  naver
  phone
}

enum UserRole {
  user
  admin
  merchant // 사장님 (인증 승인 후) — Phase 7
}

enum MerchantStatus {
  pending
  approved
  rejected
}

enum UserStatus {
  active
  banned
}

enum StoreCategory {
  vegetable
  meat
  fruit
  laundry // 세탁
  sidedish // 반찬
  salon // 미용실
  etc // 기타
}

enum StoreStatus {
  active
  hidden
}

enum StoreSource {
  user // 소비자(주민)가 등록
  merchant // 사장님이 직접 등록 (인증 후) — 후속 단계
}

enum SaleStatus {
  active
  expired
  hidden
}

enum ReportTargetType {
  store
  sale
  review
  product
}

enum ReportStatus {
  open
  resolved
}

enum PointStatus {
  pending
  granted
}

// 소비자 제보: 오늘 갑자기 휴업 / 폐업. 사진과 함께 다른 이웃에게 경고로 노출.
enum ClosureKind {
  closed_today // 원래 영업해야 하는데 오늘 갑자기 휴업
  shutdown // 폐업(영구)
}

// M0(수익화): 전환 증명을 위한 가게 행동 이벤트 종류.
enum EventType {
  impression // 지도/목록/마퀴에 노출됨
  detail_open // 가게 상세 열람
  directions_click // 길찾기 클릭
  favorite // 즐겨찾기 추가
  share // 공유
  intent_visit // 방문 의향(가게 보러가기)
}

// 이벤트 발생 위치(어느 노출 슬롯에서 왔는지) — 광고 슬롯 가치 측정용.
enum EventSource {
  pin // 지도 핀
  marquee // 상단 세일 광고판
  list // 세일 목록
  share // 공유 랜딩
  detail // 가게 상세
  other
}

// M1-B(수익화): 미전환(사장님 미인증) 가게에 대한 영업 아웃리치 상태.
enum LeadStatus {
  new // 신규(미접촉)
  contacted // 접촉함
  proposed // 제안함
  converted // 전환(사장님 인증/계약)
  dropped // 제외/보류
}

// M1-A(수익화): 스폰서(정액 광고) 상태. 묶음 상품 = 마퀴 고정 + 금색 핀.
// 결제(PG)는 M2에서 연결 — 현재 무료체험은 과금 없이 동작하고, 유료 전환은 입금 확인 후 관리자가 수동 처리.
enum SponsorStatus {
  trial // 14일 무료체험 중(과금 전)
  active // 유료 활성(입금/결제 확인됨)
  expired // 기간 만료(노출 종료)
  canceled // 취소
}

// M2(수익화): 토스 빌링키 정기결제 구독 상태.
enum SubscriptionStatus {
  trialing // 14일 무료체험(첫 청구 전)
  active // 유료 자동결제 중
  past_due // 결제 실패(재시도 대기)
  canceled // 해지(자동결제 중단)
}

// M2(수익화): 결제 시도 결과.
enum PaymentStatus {
  paid // 결제 성공
  failed // 결제 실패
}

// M3(수익화): 사장님 쿠폰 상태. 만료는 expiresAt(시각) 기준 자동 비활성(Sale.expiresAt 패턴).
enum CouponStatus {
  active // 발행·노출 중
  expired // 기간 만료(노출 종료)
  hidden // 사장님/관리자가 내림
}

// M3(수익화): 소비자 쿠폰 보유 상태.
enum CouponClaimStatus {
  claimed // 받음(미사용)
  used // 매장에서 사용 완료
}

// ──────────────────────────────────────────────────────────────
// Models
// ──────────────────────────────────────────────────────────────

model User {
  id String @id @default(cuid())
  // provider/providerId 는 레거시(주 신원 표시용). 신원의 단일 출처는 Identity.
  provider      Provider?
  providerId    String?
  name          String? // 실명 (전화번호 가입 시 입력)
  nickname      String
  // 계정 식별자(ID값): 소셜=이메일(없으면 영문4+YYYYMMDDHHmmss), 전화=전화번호.
  // 닉네임 중복과 무관한 안정적 식별자. 신원 매칭은 Identity(provider+providerId)가 담당.
  accountId     String?
  profileImgUrl String?
  phone         String?    @unique // 전화번호 로그인용 (Phase 5)
  phoneVerified Boolean    @default(false)
  contactPhone  String? // 기프티콘 수령 연락처(로그인 전화와 별개, 중복 허용)
  contactVerified Boolean @default(false) // 연락처 SMS 인증 여부(추천 보상 조건)
  role          UserRole   @default(user)
  status        UserStatus @default(active)
  points        Int        @default(0) // 표시용 (실지급 보류, 적립은 전부 PointLog.pending)
  lastCheckInDate DateTime? // 마지막 출석체크 일자(KST 자정 기준 instant)
  checkInStreak   Int      @default(0) // 연속 출석 일수
  referralCode    String?  @unique // 내 추천인 코드(공유용, 지연 생성)
  referredById    String? // 나를 추천한 사용자(가입 시 1회 설정)
  referralRewarded Boolean @default(false) // 추천 보상 지급(또는 소진) 여부 — 중복 적립 방지
  createdAt     DateTime   @default(now())

  // 관계
  identities            Identity[] // 한 User 에 여러 로그인 수단(kakao/naver/phone) 연결
  stores                Store[]    @relation("StoreCreatedBy")
  ownedStores           Store[]    @relation("StoreOwner")
  merchantVerifications MerchantVerification[]
  products   Product[]  @relation("ProductCreatedBy")
  sales      Sale[]     @relation("SaleCreatedBy")
  reviews    Review[]
  favorites  Favorite[]
  reports    Report[]   @relation("ReportReporter")
  pointLogs  PointLog[]
  closureReports ClosureReport[] @relation("ClosureReporter")
  redemptions Redemption[]
  referredBy User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[]  @relation("UserReferrals")
  inquiries  Inquiry[]
  couponsCreated Coupon[]      @relation("CouponCreatedBy") // 발행한 쿠폰(사장님/관리자)
  couponClaims   CouponClaim[] // 받은 쿠폰
}

// 로그인 수단(소셜/전화) ↔ User 연결. 계정 연결(account linking)의 핵심 (Phase 5).
model Identity {
  id         String   @id @default(cuid())
  userId     String
  provider   Provider // kakao | naver | phone
  providerId String // 소셜 고유 id 또는 전화번호
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId]) // 동일 신원 중복 연결 방지
  @@index([userId])
}

// 사장님 인증 신청 (Phase 7). 사업자등록증 이미지는 비공개 버킷 경로만 저장.
model MerchantVerification {
  id         String         @id @default(cuid())
  userId     String
  storeId    String
  docPath    String // 비공개 버킷 내 경로 (관리자만 서명 URL로 열람)
  status     MerchantStatus @default(pending)
  note       String? // 반려 사유 등
  createdAt  DateTime       @default(now())
  reviewedAt DateTime?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

// 고객센터 1:1 문의. 관리자 답변 시 status=answered, 작성자에게 답변 노출.
model Inquiry {
  id            String        @id @default(cuid())
  userId        String?
  nickname      String // 작성 시 입력(스냅샷)
  email         String // 회신 이메일
  title         String
  content       String
  attachmentUrl String? // 첨부 이미지(선택)
  status        InquiryStatus @default(open)
  answer        String? // 관리자 답변
  answeredAt    DateTime?
  createdAt     DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// 추천 보상 영구 원장: 이미 추천 보상에 사용된 연락처(해시). 탈퇴해도 남아 재가입 재적립 차단.
// PII 최소화를 위해 원문 전화번호 대신 해시만 저장.
model ReferralClaim {
  id          String   @id @default(cuid())
  contactHash String   @unique
  createdAt   DateTime @default(now())
}

// 포인트샵 기프티콘 상품 (관리자 CRUD). 포인트 = 원.
model GiftItem {
  id        String   @id @default(cuid())
  brand     String
  name      String
  points    Int
  imageUrl  String? // 업로드 이미지(없으면 이모지+색)
  emoji     String   @default("🎁")
  color     String   @default("#2563eb")
  active    Boolean  @default(true) // 비활성화하면 포인트샵에 안 보임
  sortOrder Int      @default(0)
  // M5(수익화): 제휴 커머스 정산용. costKrw=제휴사 매입 원가(실지출), faceValueKrw=액면가, partner=공급처.
  costKrw      Int? // 제휴사 매입 원가(실 변동비)
  faceValueKrw Int? // 액면가(소비자 정가) — 마진 = faceValue - cost
  partner      String? // 제휴사/공급처명
  createdAt DateTime @default(now())

  @@index([active, sortOrder])
}

// 사이트 전역 설정 (key-value). 예: intro_video_url(소개 페이지 업로드 영상)
model SiteConfig {
  key   String @id
  value String
}

// 플랫폼 공지/이벤트 (관리자 작성). 공개 목록(/notices) + 알림함(/notifications) 소스.
enum NoticeKind {
  notice // 공지
  event // 이벤트
}

model Notice {
  id        String     @id @default(cuid())
  kind      NoticeKind @default(notice)
  title     String
  body      String
  pinned    Boolean    @default(false) // 상단 고정
  active    Boolean    @default(true) // 숨김 토글
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt

  @@index([active, pinned, createdAt])
}

// 회원 탈퇴 통계 로그 (관리자 대시보드용). PII 없음 — 탈퇴 시각 + 가입 경로(provider)만.
// User 는 탈퇴 시 hard delete 되므로 별도 로그로 추이를 남긴다.
model WithdrawalLog {
  id        String    @id @default(cuid())
  provider  Provider? // 탈퇴 계정의 주 가입 경로(통계용)
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

// 전화번호 본인확인 코드 (Phase 5, 개발모드=목업 발송). 평문 저장 금지 → 해시.
model PhoneVerification {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Store {
  id          String        @id @default(cuid())
  name        String
  category    StoreCategory
  address     String
  lat         Float
  lng         Float
  phone       String?
  hoursJson   Json? // 영업시간 (요일+시간). 영업중 자동판정에 사용 (Phase 2)
  description String?
  notice     String? // 가게 공지사항 — 사장님/관리자만 작성·수정·삭제 (소비자는 조회만)
  bannerUrl   String? // 가게 상단 메인 사진 — 사장님/관리자만 설정 (Phase 7c)
  galleryUrls String[]      @default([]) // M4: 프로 플랜 사진 갤러리(여러 장) — 프로 구독 가게만 관리
  verified    Boolean       @default(false) // 미인증 가게는 회색 핀
  source      StoreSource   @default(user) // 등록 출처 (소비자/사장님) — UI 구분
  status      StoreStatus   @default(active)
  createdAt   DateTime      @default(now())

  createdById String
  createdBy   User   @relation("StoreCreatedBy", fields: [createdById], references: [id])

  ownerId String? // 사장님(merchant) 소유자 — 인증 승인 시 지정 (Phase 7)
  owner   User?   @relation("StoreOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  products              Product[]
  sales                 Sale[]
  reviews               Review[]
  favorites             Favorite[]
  closureReports        ClosureReport[]
  merchantVerifications MerchantVerification[]
  events                StoreEvent[]
  statDaily             StoreStatDaily[]
  leadOutreach          LeadOutreach?
  sponsorships          Sponsorship[]
  subscriptions         Subscription[]
  payments              Payment[]
  coupons               Coupon[]

  @@index([ownerId])

  // 현 지도 영역(bounds) 내 핀 조회 최적화 (Phase 1)
  @@index([lat, lng])
  @@index([status])
}

model Product {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  price     Int
  qtyUnit   String // 예: "1kg", "1봉"
  stock     Int?
  photoUrl  String? // 신규 등록 시 필수(앱 레벨), 시드 호환 위해 컬럼은 nullable
  origin    String? // 원산지
  hidden    Boolean  @default(false) // 신고 누적 자동 숨김 (Phase 7b)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt // 메뉴 갱신일

  store       Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User   @relation("ProductCreatedBy", fields: [createdById], references: [id])

  sales Sale[]

  @@index([storeId])
}

model Sale {
  id        String     @id @default(cuid())
  storeId   String
  productId String? // 상품과 연결되지 않은 단독 세일 가능
  title     String
  photoUrl  String // 대표(커버) 사진 = photoUrls[0]
  photoUrls String[] @default([]) // 최대 10장 (Phase 6 확장)
  salePrice Int
  qty       String
  expiresAt DateTime // 만료시간 지나면 자동 비활성
  status    SaleStatus @default(active)
  createdAt DateTime   @default(now())

  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("SaleCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@index([status, expiresAt])
}

model Review {
  id         String   @id @default(cuid())
  storeId    String
  userId     String
  rating     Int // 1~5 (앱 레벨에서 검증)
  content    String   @default("") // 자유 입력(기타) 본문 — 태그와 별개로 일반 텍스트 표시
  tags       String[] @default([]) // 빠른 태그(프리셋) — 원형 테두리 칩으로 표시
  productIds String[] @default([]) // 구매한 메뉴(상품 id) — 최소 1개 필수, 다중 선택 가능
  photoUrls  String[] @default([]) // 리뷰 사진(선택). 2번째 리뷰부터는 사진 있어야 포인트 지급
  receiptUrl String? // 영수증 인증(선택) — 비공개 버킷 경로만 저장(공개 노출 X, 배지로만 표시)
  scored     Boolean  @default(true) // 포인트·별점 반영 여부. 같은 날 같은 가게 재작성은 false
  hidden     Boolean  @default(false) // 신고 누적 N건 시 soft hide (Phase 4)
  createdAt  DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([userId])
}

model Favorite {
  userId  String
  storeId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([userId, storeId])
  @@index([storeId])
}

model Report {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String // store|sale|review 의 id (다형 참조 — FK 미설정)
  reason     String // 신고 사유 또는 정정(correction) 내용
  reporterId String
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // 신고 N건 자동 숨김 판정용 (Phase 4)
  @@index([targetType, targetId])
  @@index([status])
}

enum InquiryStatus {
  open // 문의중
  answered // 답변완료
}

enum RedemptionStatus {
  requested // 교환 신청(포인트 차감됨, 관리자 발송 대기)
  sent // 기프티콘 발송 완료
  canceled // 취소(포인트 환원)
}

// 포인트 → 기프티콘 교환 주문. 발송은 관리자가 등록 연락처로 수동 처리(외부 전문샵 구매).
model Redemption {
  id        String           @id @default(cuid())
  userId    String
  itemId    String // 카탈로그 id (constants GIFT_CATALOG)
  itemName  String // 스냅샷 (예: "스타벅스 아메리카노 T")
  points    Int // 사용 포인트
  contact   String // 수령 연락처 스냅샷
  status    RedemptionStatus @default(requested)
  note      String?
  // M5(수익화): 교환 시점 스냅샷 — 정산/마진 집계용. settledAt=제휴사 정산 완료 시각.
  costKrw   Int? // 교환 시점 매입 원가 스냅샷(실지출)
  partner   String? // 제휴사 스냅샷
  settledAt DateTime? // 제휴사 정산 완료 시각(null=미정산)
  createdAt DateTime         @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// 소비자 휴업/폐업 제보 (사진 첨부). 지도/상세에 경고로 노출, 관리자 검토.
model ClosureReport {
  id          String      @id @default(cuid())
  storeId     String
  kind        ClosureKind
  photoUrl    String? // 제보 사진 (현장 인증)
  note        String? // 한줄 메모 (선택)
  createdById String
  createdAt   DateTime    @default(now())

  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ClosureReporter", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
}

model PointLog {
  id        String      @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  status    PointStatus @default(pending) // 모든 적립은 pending (실지급 보류)
  refType   String? // 적립 근거 타입 (예: "sale")
  refId     String? // 적립 근거 id
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// M0(수익화): 가게 행동 이벤트 원본(비식별 우선). 광고/구독 과금·전환 증명 근거.
// 고빈도(impression)는 원본을 남기지 않고 StoreStatDaily 카운터만 증가시켜 쓰기량을 관리한다.
model StoreEvent {
  id        String      @id @default(cuid())
  storeId   String
  userId    String? // 로그인 사용자면 기록(비식별 분석 우선이라 nullable)
  sessionId String // 비로그인 세션 식별(랜덤) — 봇/중복 제거용
  eventType EventType
  source    EventSource @default(other)
  createdAt DateTime    @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([storeId, eventType, createdAt])
}

// M0(수익화): 일·가게 단위 집계 카운터. /api/events 가 upsert-increment.
// 사장님 노출 리포트·광고 가치 산정은 이 테이블을 읽어 빠르게 응답한다.
model StoreStatDaily {
  id               String @id @default(cuid())
  storeId          String
  day              String // "YYYY-MM-DD" (KST 기준)
  impressions      Int    @default(0)
  detailOpens      Int    @default(0)
  directionsClicks Int    @default(0)
  favorites        Int    @default(0)
  shares           Int    @default(0)
  intentVisits     Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day])
  @@index([storeId])
}

// M1-B(수익화): 영업 리드(미전환 가게) 아웃리치 추적. 가게당 1행(1:1).
model LeadOutreach {
  storeId   String     @id
  status    LeadStatus @default(new)
  note      String? // 영업 메모
  updatedBy String? // 처리한 관리자 id
  updatedAt DateTime   @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// M1-A(수익화): 스폰서 정액 광고 계약. 묶음 = 마퀴 상단 고정 + 지도 금색 핀.
// 노출 보장은 endsAt(시각) 기준으로 판정한다(Sale.expiresAt 과 동일 패턴) — 만료 시 별도 크론 없이 자동 종료.
// status 는 운영 표시·정산용. 한 가게가 기간을 갱신하며 여러 행(이력)을 가질 수 있다.
model Sponsorship {
  id          String        @id @default(cuid())
  storeId     String
  plan        String        @default("bundle") // 상품 단위(현재는 묶음만)
  region      String // 타깃 동네 라벨(영업/리포트용, 예: "이문동")
  status      SponsorStatus @default(trial)
  priceKrw    Int           @default(29800) // 월 정액(원)
  trialEndsAt DateTime // 무료체험 종료 = 과금 시작 예정 시각
  startsAt    DateTime      @default(now())
  endsAt      DateTime // 현재 노출 보장 종료 시각(체험 또는 결제 주기)
  note        String? // 운영 메모
  // M2: 자동결제 구독에서 생성·연장된 스폰서면 연결(관리자 컴프 스폰서는 null).
  subscriptionId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, endsAt])
  @@index([storeId])
  @@index([subscriptionId])
}

// M2(수익화): 토스 빌링키 기반 스폰서 정기결제 구독. 사장님이 카드를 등록(빌링키)하면
// 14일 무료체험 후 매월 자동청구된다. 결제 성공이 Sponsorship(노출)을 생성·연장한다.
// 가게당 활성 1개를 권장하나, 해지·재구독 이력을 위해 여러 행을 허용한다.
model Subscription {
  id          String             @id @default(cuid())
  storeId     String
  userId      String // 구독한 사장님(소유자)
  customerKey String             @unique // 토스 고객키(가게/구독 단위 고유)
  billingKey  String? // 토스 발급 빌링키(카드 등록 성공 후) — 평문 저장은 토스 권장 보관 방식
  plan        String             @default("sponsor") // M4: "sponsor"(마퀴+금색핀) | "pro"(스폰서+프리미엄 혜택)
  status      SubscriptionStatus @default(trialing)
  priceKrw    Int                @default(29800)
  trialEndsAt DateTime // 무료체험 종료 = 첫 청구 예정
  nextBillingAt DateTime // 다음 청구 예정 시각(크론이 이 값으로 청구 대상 선별)
  lastPaymentAt DateTime?
  canceledAt  DateTime?
  failCount   Int                @default(0) // 연속 결제 실패 횟수(3회 누적 시 해지)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sponsorships Sponsorship[]
  payments     Payment[]

  @@index([status, nextBillingAt])
  @@index([storeId])
}

// M2(수익화): 결제 시도 감사 로그(성공/실패). 정산·문의 대응 근거.
model Payment {
  id             String        @id @default(cuid())
  subscriptionId String
  storeId        String
  orderId        String        @unique // 토스 주문번호(멱등키)
  amount         Int
  status         PaymentStatus
  tossPaymentKey String? // 토스 결제키(성공 시)
  method         String? // 결제수단(카드 등)
  failReason     String? // 실패 사유
  createdAt      DateTime      @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([storeId])
}

// M3(수익화): 사장님 쿠폰. 인증 사장님(소유자)·관리자가 본인 가게 쿠폰을 발행하고,
// 소비자가 받아(claim) 매장에서 사용(use)한다. 발행/관리는 canManageStore, 1인 1매(CouponClaim @@unique).
// 노출 보장은 expiresAt(시각) 기준 — Sale 과 동일 패턴이라 만료 크론이 필요 없다.
model Coupon {
  id          String       @id @default(cuid())
  storeId     String
  title       String // 혜택 (예: "5,000원 이상 1,000원 할인")
  description String? // 상세 설명(선택)
  condition   String? // 사용 조건 텍스트 (예: "1만원 이상 구매 시")
  totalLimit  Int? // 발행 수량 한도(선택, null=무제한)
  status      CouponStatus @default(active)
  expiresAt   DateTime // 만료 시각 지나면 자동 비활성
  createdById String // 발행한 사장님(또는 관리자)
  createdAt   DateTime     @default(now())

  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User          @relation("CouponCreatedBy", fields: [createdById], references: [id])
  claims    CouponClaim[]

  @@index([storeId])
  @@index([status, expiresAt])
}

// M3(수익화): 소비자의 쿠폰 보유(받기→사용). 1인 1매(@@unique). 사용은 스캐너 없이 수동 처리(앱 신뢰 모델).
model CouponClaim {
  id        String            @id @default(cuid())
  couponId  String
  userId    String
  status    CouponClaimStatus @default(claimed)
  claimedAt DateTime          @default(now())
  usedAt    DateTime?

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([userId])
}
