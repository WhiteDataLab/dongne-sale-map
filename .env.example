# ──────────────────────────────────────────────────────────────
# 동네 세일 지도 — 환경변수 예시
# 실제 값은 .env.local 에 넣고 절대 커밋하지 않는다. (.gitignore 처리됨)
# 키가 없어도 빌드는 통과하도록 코드가 가드되어 있다(스펙 7장).
# ──────────────────────────────────────────────────────────────

# ── Database (PostgreSQL / Supabase 권장) ────────────────────────
# DATABASE_URL : 앱 런타임용 (서버리스 → 풀링된 포트 6543, pgbouncer 사용)
# DIRECT_URL   : 마이그레이션용 직접 연결 (포트 5432)
# Supabase 대시보드 > Project Settings > Database 에서 확인.
DATABASE_URL=""
DIRECT_URL=""

# ── Auth.js (NextAuth v5) ───────────────────────────────────────
# AUTH_SECRET : `npx auth secret` 또는 `openssl rand -base64 32` 로 생성
AUTH_SECRET=""
# 배포 시 실제 도메인 (로컬은 비워두면 http://localhost:3000)
# AUTH_URL="https://your-domain.com"

# ── 카카오 로그인 (developers.kakao.com) ─────────────────────────
# REST API 키 = clientId, 보안 > Client Secret = clientSecret
# Redirect URI: http://localhost:3000/api/auth/callback/kakao
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# ── 네이버 로그인 (developers.naver.com) ─────────────────────────
# 애플리케이션 등록 > Client ID / Client Secret
# Callback URL: http://localhost:3000/api/auth/callback/naver
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# ── 카카오맵 (Phase 1에서 사용) ─────────────────────────────────
# JS 키: 클라이언트(브라우저)에서 지도 렌더링 → NEXT_PUBLIC_ 접두사 (노출됨)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=""
# REST 키: 서버에서 로컬(주소/키워드) 검색 → 절대 클라이언트 노출 금지
KAKAO_REST_API_KEY=""

# ── 이미지 스토리지 (Phase 3, Supabase Storage / 서버 전용) ──────
# 제보 사진 업로드. service_role 키는 절대 클라이언트에 노출 금지.
# public 버킷 `sale-photos` 가 필요 (없으면 업로드 시 503).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── SMS 본인확인 (Phase 5) ──────────────────────────────────────
# 미설정 시 개발모드(목업): 실제 발송 없이 인증번호를 응답/로그로 노출.
# 실제 발송사(CoolSMS/알리고/SENS 등) 연동 시 SMS_PROVIDER 와 관련 키 설정.
# SMS_PROVIDER=""
